# cspell:words redir
:8080 {
	handle /web-health {
		respond 204
	}

	handle /runtime-config.json {
		header Cache-Control "no-store"
		header Content-Type "application/json; charset=utf-8"
		respond `{"apiOrigin":"{$PUBLIC_API_ORIGIN}","viewerOrigin":"{$PUBLIC_VIEWER_ORIGIN}","galleryContentOrigin":"{$PUBLIC_GALLERY_CONTENT_ORIGIN}","galleryTurnstileSiteKey":"{$PUBLIC_GALLERY_TURNSTILE_SITE_KEY}"}` 200
	}

	@nonCanonical {
		not host {$WEB_CANONICAL_HOST}
		not path /web-health /runtime-config.json
	}
	redir @nonCanonical {$WEB_ORIGIN}{uri} 308

	handle /internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle /a/* {
		reverse_proxy {$API_UPSTREAM}
	}

	@galleryDownload path_regexp galleryDownload ^/gallery/[^/]+/download$
	handle @galleryDownload {
		reverse_proxy {$API_UPSTREAM}
	}

	@galleryJson {
		path /gallery /gallery/*
		header Accept application/json*
	}
	handle @galleryJson {
		reverse_proxy {$API_UPSTREAM}
	}

	handle /gallery-media/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle /health {
		reverse_proxy {$API_UPSTREAM}
	}

	handle /ready {
		reverse_proxy {$API_UPSTREAM}
	}

	@preview path /console/artifacts/*/preview /artifacts/*/preview
	handle @preview {
		root * /srv
		rewrite * /index.html
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
