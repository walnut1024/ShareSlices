{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shareslices.example/deploy/contract/release.schema.json",
  "title": "ShareSlices immutable release bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "sourceRevision",
    "target",
    "artifacts",
    "migrations",
    "migrationCompatibility",
    "compatibility",
    "contractCompatibility",
    "contractRevisions",
    "configurationDigest",
    "routeContractDigest",
    "cacheContractDigest",
    "verificationContractDigest",
    "buildProvenance",
    "providerToolchain",
    "secretRevisions",
    "inventory",
    "ownershipMarkers"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "shareslices.release/v1" },
    "releaseId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "previousReleaseId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "target": { "enum": ["kubernetes", "cloudflare"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration" }
    },
    "migrationCompatibility": {
      "type": "array",
      "items": { "$ref": "#/$defs/migrationCompatibility" }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "contractCompatibility": { "$ref": "#/$defs/contractCompatibility" },
    "contractRevisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "database", "jobs", "objectLayout", "verification"],
      "properties": {
        "deployment": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "jobs": { "type": "string", "minLength": 1 },
        "objectLayout": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "configurationDigest": { "$ref": "#/$defs/sha256" },
    "routeContractDigest": { "$ref": "#/$defs/sha256" },
    "cacheContractDigest": { "$ref": "#/$defs/sha256" },
    "verificationContractDigest": { "$ref": "#/$defs/sha256" },
    "buildProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "invocationId", "sourceClean", "builtAt"],
      "properties": {
        "builder": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "sourceClean": { "const": true },
        "builtAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" }
      }
    },
    "providerToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineVersion", "identities"],
      "properties": {
        "baselineVersion": { "type": "integer", "minimum": 1 },
        "identities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secretRevisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/secretRevision" }
    },
    "inventory": {
      "type": "array",
      "items": { "$ref": "#/$defs/inventoryItem" }
    },
    "ownershipMarkers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifactKind", "contentDigest", "providerIdentity"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "artifactKind": { "enum": ["oci-image", "worker-bundle", "static-assets"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^linux/(amd64|arm64)$" }
        },
        "contentDigest": { "$ref": "#/$defs/sha256" },
        "providerIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "qualified", "mutable"],
          "properties": {
            "kind": { "enum": ["digest", "version_id", "release_tag"] },
            "value": { "type": "string", "minLength": 1 },
            "qualified": { "const": true },
            "mutable": { "const": false },
            "verifiedContentDigest": { "$ref": "#/$defs/sha256" }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "release_tag" } } },
              "then": { "required": ["verifiedContentDigest"] }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "artifactKind": { "const": "oci-image" } } },
          "then": { "required": ["platforms"] },
          "else": { "not": { "required": ["platforms"] } }
        }
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "checksum"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "migrationCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "migrationId", "schemaHead", "runtimeN", "runtimeNMinus1", "jobsContractRevision", "objectLayoutRevision", "evidenceDigest"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "migrationId": { "type": "string", "minLength": 1 },
        "schemaHead": { "type": "string", "minLength": 1 },
        "runtimeN": { "const": "passed" },
        "runtimeNMinus1": { "enum": ["passed", "not_applicable"] },
        "jobsContractRevision": { "type": "string", "minLength": 1 },
        "objectLayoutRevision": { "type": "string", "minLength": 1 },
        "evidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "contractCompatibilitySide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "fixtureDigest"],
      "properties": {
        "revision": { "type": ["string", "null"], "minLength": 1 },
        "fixtureDigest": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "contractCompatibilityPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "previous"],
      "properties": {
        "current": { "$ref": "#/$defs/contractCompatibilitySide" },
        "previous": { "$ref": "#/$defs/contractCompatibilitySide" }
      }
    },
    "contractCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "objectLayout"],
      "properties": {
        "jobs": { "$ref": "#/$defs/contractCompatibilityPair" },
        "objectLayout": { "$ref": "#/$defs/contractCompatibilityPair" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaHead", "runtimeN", "runtimeNMinus1", "minimumDeploymentSchemaVersion", "migrationPrefixesCompatibleWithNMinus1", "adjacentArtifactsCompatible"],
      "properties": {
        "schemaHead": { "type": "string", "minLength": 1 },
        "runtimeN": { "type": "string", "minLength": 1 },
        "runtimeNMinus1": { "type": ["string", "null"] },
        "minimumDeploymentSchemaVersion": { "type": "string", "minLength": 1 },
        "migrationPrefixesCompatibleWithNMinus1": { "const": true },
        "adjacentArtifactsCompatible": { "const": true }
      }
    },
    "secretRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalId", "revision"],
      "properties": {
        "logicalId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "revision": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalId", "owner", "retention"],
      "properties": {
        "logicalId": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["deployment-module", "external-prerequisite"] },
        "retention": { "enum": ["active", "rollback", "durable", "external"] }
      }
    }
  }
}
