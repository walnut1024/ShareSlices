{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shareslices.example/deploy/contract/verification-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "topology",
    "addresses",
    "requiredCapabilities",
    "disabledCapabilities",
    "expectedNotApplicable"
  ],
  "properties": {
    "schemaVersion": { "const": "shareslices.verification-fixture/v1" },
    "topology": { "enum": ["compose", "kubernetes", "cloudflare"] },
    "addresses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "api", "viewer", "content", "origin", "edge"],
      "properties": {
        "web": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "api": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "viewer": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "content": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "origin": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "edge": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "disabledCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "expectedNotApplicable": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    }
  }
}
