{
  "$schema": "../deployment.schema.json",
  "schemaVersion": "shareslices.deployment/v1",
  "installationId": "example-kubernetes",
  "target": "kubernetes",
  "shared": {
    "database": { "ref": "secret://postgres/application", "revision": "7" },
    "sessionSigningKeys": [
      { "ref": "secret://signing/current", "revision": "4" }
    ],
    "publicOrigins": {
      "application": "https://app.example.test",
      "content": "https://content.example.test"
    },
    "recoverability": {
      "postgresql": {
        "owner": "database-team",
        "encryptedLocation": "backup://postgresql/example-kubernetes",
        "retention": "30d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 3600,
        "rtoSeconds": 14400
      },
      "objectStorage": {
        "owner": "storage-team",
        "encryptedLocation": "backup://objects/example-kubernetes",
        "retention": "30d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 3600,
        "rtoSeconds": 14400
      },
      "iacState": {
        "owner": "platform-team",
        "encryptedLocation": "state://kubernetes/example-kubernetes",
        "retention": "90d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 3600,
        "rtoSeconds": 7200
      },
      "releaseBundles": {
        "owner": "release-team",
        "encryptedLocation": "release://example-kubernetes",
        "retention": "90d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 0,
        "rtoSeconds": 3600
      },
      "deploymentJournal": {
        "owner": "release-team",
        "encryptedLocation": "journal://example-kubernetes",
        "retention": "90d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 0,
        "rtoSeconds": 3600
      }
    }
  },
  "kubernetes": {
    "reconciliation": { "mode": "direct", "owner": "deployment-module" },
    "context": "enterprise-production",
    "fieldManager": "shareslices-deployment",
    "minimumVersion": "1.30.0",
    "namespace": "shareslices",
    "delivery": { "mode": "external-cdn" },
    "registry": {
      "repository": "registry.example.test/shareslices",
      "pullSecretName": "shareslices-registry"
    },
    "releaseStore": { "ref": "secret://release-store/deploy-pull", "revision": "5" },
    "databaseEndpoint": { "host": "db.example.test", "port": 5432, "tlsPolicy": "verify-full" },
    "objectStorage": { "ref": "secret://s3/application", "revision": "3" },
    "objectStorageEndpoint": "https://objects.example.test",
    "email": {
      "adapter": "smtp",
      "smtp": { "ref": "secret://smtp/transactional", "revision": "9" },
      "relayNamespace": "enterprise-transactional",
      "endpointIdentity": "smtp.example.test:587",
      "configurationRevision": "smtp-config-9",
      "sender": "no-reply@example.test",
      "tlsPolicy": "starttls-required"
    },
    "connectionBudget": { "databaseMaximum": 100, "allocatedMaximum": 40 },
    "ingress": {
      "className": "nginx",
      "tls": {
        "applicationSecretName": "shareslices-app-tls",
        "contentSecretName": "shareslices-content-tls"
      },
      "externalCdn": {
        "enabled": true,
        "provider": "enterprise-edge",
        "originAccess": {
          "mode": "provider-address-ranges",
          "evidenceRevision": "enterprise-edge-origin-v1"
        },
        "trustedProxy": {
          "sourceCidrs": ["192.0.2.0/24", "198.51.100.0/24"],
          "clientAddressHeader": "forwarded",
          "evidenceRevision": "enterprise-edge-proxy-v1"
        }
      }
    },
    "network": {
      "cni": {
        "name": "cilium",
        "networkPolicyEnforced": true,
        "clusterIdentity": "enterprise-production-cluster-1",
        "policyRevision": "cilium-policy-v1",
        "allowedAndDeniedFlowsPassed": true,
        "evidenceObservedAt": "2026-07-21T00:00:00Z",
        "maximumEvidenceAgeSeconds": 86400
      },
      "dns": {
        "namespace": "kube-system",
        "podLabels": { "k8s-app": "kube-dns" }
      },
      "ingressController": {
        "namespace": "ingress-nginx",
        "podLabels": { "app.kubernetes.io/component": "controller" }
      },
      "egress": {
        "mode": "egress-gateway",
        "gateway": {
          "namespace": "shareslices-egress",
          "podLabels": { "app.kubernetes.io/name": "shareslices-egress-gateway" }
        }
      }
    },
    "workloads": {
      "api": {
        "replicas": 2,
        "resources": { "requests": { "cpu": "100m", "memory": "256Mi" }, "limits": { "cpu": "1", "memory": "1Gi" } },
        "rollout": { "maxUnavailable": 0, "maxSurge": 1 },
        "disruption": { "minAvailable": 1 },
        "scheduling": { "nodeSelector": { "kubernetes.io/os": "linux" }, "topologyKey": "kubernetes.io/hostname" }
      },
      "web": {
        "replicas": 2,
        "resources": { "requests": { "cpu": "25m", "memory": "64Mi" }, "limits": { "cpu": "250m", "memory": "256Mi" } },
        "rollout": { "maxUnavailable": 0, "maxSurge": 1 },
        "disruption": { "minAvailable": 1 },
        "scheduling": { "nodeSelector": { "kubernetes.io/os": "linux" }, "topologyKey": "kubernetes.io/hostname" }
      },
      "content": {
        "replicas": 2,
        "resources": { "requests": { "cpu": "50m", "memory": "128Mi" }, "limits": { "cpu": "500m", "memory": "512Mi" } },
        "rollout": { "maxUnavailable": 0, "maxSurge": 1 },
        "disruption": { "minAvailable": 1 },
        "scheduling": { "nodeSelector": { "kubernetes.io/os": "linux" }, "topologyKey": "kubernetes.io/hostname" }
      },
      "maintenance": {
        "replicas": 1,
        "resources": { "requests": { "cpu": "50m", "memory": "128Mi" }, "limits": { "cpu": "500m", "memory": "512Mi" } },
        "rollout": { "maxUnavailable": 0, "maxSurge": 1 },
        "disruption": { "minAvailable": 1 },
        "scheduling": { "nodeSelector": { "kubernetes.io/os": "linux" }, "topologyKey": "kubernetes.io/hostname" }
      },
      "worker": {
        "replicas": 2,
        "resources": { "requests": { "cpu": "250m", "memory": "512Mi" }, "limits": { "cpu": "2", "memory": "2Gi" } },
        "rollout": { "maxUnavailable": 0, "maxSurge": 1 },
        "disruption": { "minAvailable": 1 },
        "scheduling": { "nodeSelector": { "kubernetes.io/os": "linux" }, "topologyKey": "kubernetes.io/hostname" }
      }
    }
  }
}
