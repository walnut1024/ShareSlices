{
  "$schema": "../deployment.schema.json",
  "schemaVersion": "shareslices.deployment/v1",
  "installationId": "example-cloudflare",
  "target": "cloudflare",
  "shared": {
    "database": { "ref": "secret://supabase/direct", "revision": "12" },
    "sessionSigningKeys": [
      { "ref": "secret://workers/signing-current", "revision": "4" },
      { "ref": "secret://workers/signing-previous", "revision": "3" }
    ],
    "roleSecrets": {
      "authenticationEmailEncryption": { "ref": "secret://workers/auth-email-encryption", "revision": "2" },
      "contentFingerprint": {
        "current": { "ref": "secret://workers/content-fingerprint-current", "revision": "3" }
      },
      "idempotencyEncryption": {
        "current": { "ref": "secret://workers/idempotency-current", "revision": "5" }
      }
    },
    "gallery": {
      "enabled": true,
      "managementCookieDomain": "example.test",
      "grantRevision": "grant-v1",
      "appealPolicyRevision": "appeal-v1",
      "challengeVerifierReady": false,
      "administratorAuthorityReady": false,
      "reportingReady": false,
      "notificationReady": false,
      "appealReady": false,
      "governanceReady": false,
      "isolatedContentReady": false
    },
    "publicOrigins": {
      "application": "https://app.example.test",
      "content": "https://content.example-content.test"
    },
    "recoverability": {
      "postgresql": {
        "owner": "database-team",
        "encryptedLocation": "backup://postgresql/example-cloudflare",
        "retention": "30d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 3600,
        "rtoSeconds": 14400
      },
      "objectStorage": {
        "owner": "storage-team",
        "encryptedLocation": "backup://r2/example-cloudflare",
        "retention": "30d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 3600,
        "rtoSeconds": 14400
      },
      "iacState": {
        "owner": "platform-team",
        "encryptedLocation": "state://cloudflare/example-cloudflare",
        "retention": "90d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 3600,
        "rtoSeconds": 7200
      },
      "releaseBundles": {
        "owner": "release-team",
        "encryptedLocation": "release://example-cloudflare",
        "retention": "90d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 0,
        "rtoSeconds": 3600
      },
      "deploymentJournal": {
        "owner": "release-team",
        "encryptedLocation": "journal://example-cloudflare",
        "retention": "90d",
        "observedAt": "2026-07-21T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "rpoSeconds": 0,
        "rtoSeconds": 3600
      }
    }
  },
  "cloudflare": {
    "accountId": "0123456789abcdef0123456789abcdef",
    "providerReadToken": { "ref": "secret://cloudflare/provider-read", "revision": "1" },
    "postgresqlOrigin": { "ref": "secret://supabase/hyperdrive", "revision": "8" },
    "releaseStore": { "ref": "secret://release-store/deploy-pull", "revision": "5" },
    "email": {
      "adapter": "resend",
      "endpoint": "https://api.resend.com/emails",
      "teamNamespace": "shareslices-production",
      "senderAddress": "no-reply@mail.example.test",
      "sendingDomain": "mail.example.test",
      "transportRevision": "resend-v1",
      "trackingDisabled": true,
      "resend": { "ref": "secret://resend/sending", "revision": "2" },
      "operatorEvidence": {
        "observedAt": "2026-07-24T00:00:00Z",
        "maximumAgeSeconds": 86400,
        "teamNamespace": "shareslices-production",
        "sendingDomain": "mail.example.test",
        "keyRevision": "2",
        "domainVerified": true,
        "trackingDisabled": true,
        "accountOperational": true
      }
    },
    "edgeCdn": {
      "mode": "web-assets-only",
      "maximumViewerAssetBytes": 5242880
    },
    "workers": {
      "application": "shareslices-app",
      "content": "shareslices-content",
      "jobs": "shareslices-jobs"
    },
    "r2": {
      "artifactBucket": "shareslices-artifacts",
      "deploymentStateBucket": "shareslices-deployment-state"
    },
    "queues": {
      "jobs": "shareslices-jobs",
      "deadLetter": "shareslices-jobs-dead-letter"
    },
    "costControls": {
      "maximumUploadBytes": 52428800,
      "staticAssets": {
        "maximumFiles": 100000,
        "maximumFileBytes": 26214400
      },
      "workerCpuMilliseconds": {
        "application": 30000,
        "content": 30000,
        "jobs": 30000,
        "operatorSafetyCap": 30000
      },
      "queue": {
        "maximumBatchSize": 10,
        "maximumRetries": 3,
        "maximumConcurrency": 4
      },
      "schedule": {
        "cron": "*/5 * * * *"
      },
      "containers": {
        "trustedProcessing": {
          "instanceType": "basic",
          "runnerSlots": 2,
          "maximumInstances": 2,
          "operatorSafetyCapInstances": 2,
          "maximumClaimsPerDrain": 8,
          "maximumWallTimeSeconds": 600,
          "maximumConcurrency": 2,
          "sleepAfterSeconds": 60
        },
        "thumbnail": {
          "instanceType": "standard-1",
          "runnerSlots": 1,
          "maximumInstances": 1,
          "operatorSafetyCapInstances": 1,
          "maximumClaimsPerDrain": 2,
          "maximumWallTimeSeconds": 300,
          "maximumConcurrency": 1,
          "sleepAfterSeconds": 30
        }
      },
      "workerFirstRouteFamilies": [
        "web",
        "api",
        "authentication",
        "management",
        "upload",
        "preview",
        "viewer",
        "gallery",
        "content"
      ]
    }
  }
}
