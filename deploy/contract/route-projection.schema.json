{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shareslices.example/deploy/contract/route-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rows"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "shareslices.routes/v1" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operationId"],
          "properties": {
            "kind": { "const": "openapi" },
            "operationId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "document", "section"],
          "properties": {
            "kind": { "const": "documented-route-family" },
            "document": { "type": "string", "minLength": 1 },
            "section": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "pathPattern",
        "methods",
        "ingress",
        "owner",
        "cachePolicy",
        "forbidden"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "family": {
          "enum": [
            "web",
            "public",
            "viewer",
            "preview",
            "gallery",
            "content-only",
            "health",
            "internal"
          ]
        },
        "pathPattern": { "type": "string", "pattern": "^/" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "ANY"] }
        },
        "ingress": { "enum": ["trusted", "content-only", "none"] },
        "owner": { "$ref": "#/$defs/owner" },
        "cachePolicy": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "forbidden": { "type": "boolean" }
      }
    }
  }
}
