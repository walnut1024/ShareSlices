{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shareslices.example/deploy/contract/cache-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "privateObjectStorage", "policies"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "shareslices.cache/v1" },
    "privateObjectStorage": { "const": true },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "enabled",
        "outwardCacheControl",
        "rangeBehavior",
        "authorization"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "scope": { "enum": ["edge-response", "internal-immutable-bytes", "bypass", "forbidden"] },
        "enabled": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "outwardCacheControl": { "type": "string", "minLength": 1 },
        "rangeBehavior": { "enum": ["cache-full-body-only", "bypass", "not-applicable"] },
        "authorization": { "enum": ["before-cache", "not-required", "not-applicable"] },
        "contentHashRequired": { "type": "boolean" },
        "representationKeyInputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "routeFamilies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
