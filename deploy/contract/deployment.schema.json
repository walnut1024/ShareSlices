{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shareslices.example/deploy/contract/deployment.schema.json",
  "title": "ShareSlices production deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installationId",
    "target",
    "shared"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "shareslices.deployment/v1" },
    "installationId": { "$ref": "#/$defs/dnsLabel" },
    "target": { "enum": ["kubernetes", "cloudflare"] },
    "shared": { "$ref": "#/$defs/shared" },
    "kubernetes": { "$ref": "#/$defs/kubernetes" },
    "cloudflare": { "$ref": "#/$defs/cloudflare" }
  },
  "oneOf": [
    {
      "properties": {
        "target": { "const": "kubernetes" },
        "kubernetes": { "$ref": "#/$defs/kubernetes" },
        "cloudflare": false
      },
      "required": ["kubernetes"]
    },
    {
      "properties": {
        "target": { "const": "cloudflare" },
        "kubernetes": false,
        "cloudflare": { "$ref": "#/$defs/cloudflare" }
      },
      "required": ["cloudflare"]
    }
  ],
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "cidrList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$",
        "not": { "const": "0.0.0.0/0" }
      }
    },
    "namespacedPodSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "podLabels"],
      "properties": {
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "podLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resourceQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:m|Ki|Mi|Gi)?$"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources", "rollout", "disruption", "scheduling"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 100 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "$ref": "#/$defs/resourceQuantity" },
                "memory": { "$ref": "#/$defs/resourceQuantity" }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "$ref": "#/$defs/resourceQuantity" },
                "memory": { "$ref": "#/$defs/resourceQuantity" }
              }
            }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxUnavailable", "maxSurge"],
          "properties": {
            "maxUnavailable": { "type": "integer", "minimum": 0 },
            "maxSurge": { "type": "integer", "minimum": 0 }
          }
        },
        "disruption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minAvailable"],
          "properties": { "minAvailable": { "type": "integer", "minimum": 0 } }
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeSelector", "topologyKey"],
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "topologyKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(?:secret|kubernetes-secret|cloudflare-secret)://[A-Za-z0-9._/-]+$",
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      }
    },
    "rotatingSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current"],
      "properties": {
        "current": { "$ref": "#/$defs/secretReference" },
        "previous": { "$ref": "#/$defs/secretReference" }
      }
    },
    "recoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "encryptedLocation",
        "retention",
        "observedAt",
        "maximumAgeSeconds",
        "rpoSeconds",
        "rtoSeconds"
      ],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "encryptedLocation": { "type": "string", "minLength": 1 },
        "retention": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "maximumAgeSeconds": { "type": "integer", "minimum": 1 },
        "rpoSeconds": { "type": "integer", "minimum": 0 },
        "rtoSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "sessionSigningKeys",
        "roleSecrets",
        "publicOrigins",
        "recoverability"
      ],
      "properties": {
        "database": { "$ref": "#/$defs/secretReference" },
        "sessionSigningKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/secretReference" }
        },
        "roleSecrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authenticationEmailEncryption",
            "contentFingerprint",
            "idempotencyEncryption"
          ],
          "properties": {
            "authenticationEmailEncryption": { "$ref": "#/$defs/secretReference" },
            "contentFingerprint": { "$ref": "#/$defs/rotatingSecret" },
            "idempotencyEncryption": { "$ref": "#/$defs/rotatingSecret" },
            "galleryTurnstile": { "$ref": "#/$defs/secretReference" }
          }
        },
        "publicOrigins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["application", "content"],
          "properties": {
            "application": { "$ref": "#/$defs/httpsUrl" },
            "content": { "$ref": "#/$defs/httpsUrl" }
          }
        },
        "recoverability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "postgresql",
            "objectStorage",
            "iacState",
            "releaseBundles",
            "deploymentJournal"
          ],
          "properties": {
            "postgresql": { "$ref": "#/$defs/recoveryEvidence" },
            "objectStorage": { "$ref": "#/$defs/recoveryEvidence" },
            "iacState": { "$ref": "#/$defs/recoveryEvidence" },
            "releaseBundles": { "$ref": "#/$defs/recoveryEvidence" },
            "deploymentJournal": { "$ref": "#/$defs/recoveryEvidence" }
          }
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "fieldManager", "minimumVersion", "namespace", "reconciliation", "delivery", "registry", "releaseStore", "databaseEndpoint", "objectStorage", "objectStorageEndpoint", "email", "connectionBudget", "ingress", "network", "workloads"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "fieldManager": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "owner"],
          "properties": {
            "mode": { "enum": ["direct", "gitops"] },
            "owner": { "enum": ["deployment-module", "external"] }
          },
          "oneOf": [
            {
              "properties": {
                "mode": { "const": "direct" },
                "owner": { "const": "deployment-module" }
              }
            },
            {
              "properties": {
                "mode": { "const": "gitops" },
                "owner": { "const": "external" }
              }
            }
          ]
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "enum": ["direct", "external-cdn"] } }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "pullSecretName"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]*[a-z0-9]$" },
            "pullSecretName": { "$ref": "#/$defs/dnsLabel" }
          }
        },
        "releaseStore": { "$ref": "#/$defs/secretReference" },
        "databaseEndpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "tlsPolicy"],
          "properties": {
            "host": { "type": "string", "format": "hostname" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "tlsPolicy": { "const": "verify-full" }
          }
        },
        "objectStorage": { "$ref": "#/$defs/secretReference" },
        "objectStorageEndpoint": { "$ref": "#/$defs/httpsUrl" },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "smtp", "relayNamespace", "endpointIdentity", "configurationRevision", "sender", "tlsPolicy"],
          "properties": {
            "adapter": { "const": "smtp" },
            "smtp": { "$ref": "#/$defs/secretReference" },
            "relayNamespace": { "type": "string", "minLength": 1 },
            "endpointIdentity": { "type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$" },
            "configurationRevision": { "type": "string", "minLength": 1 },
            "sender": { "type": "string", "format": "email" },
            "tlsPolicy": { "enum": ["starttls-required", "tls-required"] }
          }
        },
        "connectionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["databaseMaximum", "allocatedMaximum"],
          "properties": {
            "databaseMaximum": { "type": "integer", "minimum": 1 },
            "allocatedMaximum": { "type": "integer", "minimum": 1 }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className", "tls", "externalCdn"],
          "properties": {
            "className": { "type": "string", "minLength": 1 },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["applicationSecretName", "contentSecretName"],
              "properties": {
                "applicationSecretName": { "$ref": "#/$defs/dnsLabel" },
                "contentSecretName": { "$ref": "#/$defs/dnsLabel" }
              }
            },
            "externalCdn": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "provider": { "type": "string", "minLength": 1 },
                "originOrigins": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["application", "content"],
                  "properties": {
                    "application": { "$ref": "#/$defs/httpsUrl" },
                    "content": { "$ref": "#/$defs/httpsUrl" }
                  }
                },
                "originAccess": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "evidenceRevision"],
                  "properties": {
                    "mode": { "enum": ["provider-address-ranges", "authenticated-origin"] },
                    "evidenceRevision": { "type": "string", "minLength": 1 }
                  }
                },
                "trustedProxy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceCidrs", "clientAddressHeader", "evidenceRevision"],
                  "properties": {
                    "sourceCidrs": { "$ref": "#/$defs/cidrList" },
                    "clientAddressHeader": { "enum": ["forwarded", "x-forwarded-for"] },
                    "evidenceRevision": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } } },
                  "then": { "required": ["provider", "originOrigins", "originAccess", "trustedProxy"] },
                  "else": {
                    "not": {
                      "anyOf": [
                        { "required": ["provider"] },
                        { "required": ["originOrigins"] },
                        { "required": ["originAccess"] },
                        { "required": ["trustedProxy"] }
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cni", "dns", "ingressController", "egress"],
          "properties": {
            "cni": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "networkPolicyEnforced", "clusterIdentity", "policyRevision", "allowedAndDeniedFlowsPassed", "evidenceObservedAt", "maximumEvidenceAgeSeconds"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "networkPolicyEnforced": { "const": true },
                "clusterIdentity": { "type": "string", "minLength": 1 },
                "policyRevision": { "type": "string", "minLength": 1 },
                "allowedAndDeniedFlowsPassed": { "const": true },
                "evidenceObservedAt": { "type": "string", "format": "date-time" },
                "maximumEvidenceAgeSeconds": { "type": "integer", "minimum": 1 }
              }
            },
            "dns": { "$ref": "#/$defs/namespacedPodSelector" },
            "ingressController": { "$ref": "#/$defs/namespacedPodSelector" },
            "egress": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "postgresqlCidrs", "objectStorageCidrs", "smtpCidrs"],
                  "properties": {
                    "mode": { "const": "stable-cidrs" },
                    "postgresqlCidrs": { "$ref": "#/$defs/cidrList" },
                    "objectStorageCidrs": { "$ref": "#/$defs/cidrList" },
                    "smtpCidrs": { "$ref": "#/$defs/cidrList" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "gateway"],
                  "properties": {
                    "mode": { "const": "egress-gateway" },
                    "gateway": { "$ref": "#/$defs/namespacedPodSelector" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "apiVersion", "kind", "qualificationRevision", "postgresqlFqdns", "objectStorageFqdns", "smtpFqdns"],
                  "properties": {
                    "mode": { "const": "cni-fqdn-policy" },
                    "apiVersion": { "const": "cilium.io/v2" },
                    "kind": { "const": "CiliumNetworkPolicy" },
                    "qualificationRevision": { "type": "string", "minLength": 1 },
                    "postgresqlFqdns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "hostname" } },
                    "objectStorageFqdns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "hostname" } },
                    "smtpFqdns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "hostname" } }
                  }
                }
              ]
            }
          }
        },
        "workloads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "web", "content", "maintenance", "worker"],
          "properties": {
            "api": { "$ref": "#/$defs/workload" },
            "web": { "$ref": "#/$defs/workload" },
            "content": { "$ref": "#/$defs/workload" },
            "maintenance": { "$ref": "#/$defs/workload" },
            "worker": { "$ref": "#/$defs/workload" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "type": "object",
                "properties": { "mode": { "const": "external-cdn" } }
              }
            }
          },
          "then": {
            "properties": {
              "ingress": {
                "type": "object",
                "properties": {
                  "externalCdn": {
                    "type": "object",
                    "properties": { "enabled": { "const": true } }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "ingress": {
                "type": "object",
                "properties": {
                  "externalCdn": {
                    "type": "object",
                    "properties": { "enabled": { "const": false } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "postgresqlOrigin",
        "email",
        "edgeCdn",
        "workers",
        "r2",
        "queues"
      ],
      "properties": {
        "accountId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "postgresqlOrigin": { "$ref": "#/$defs/secretReference" },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "resend"],
          "properties": {
            "adapter": { "const": "resend" },
            "resend": { "$ref": "#/$defs/secretReference" }
          }
        },
        "edgeCdn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["web-assets-only", "web-and-public-viewer-bytes"]
            }
          }
        },
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["application", "content", "jobs"],
          "properties": {
            "application": { "$ref": "#/$defs/dnsLabel" },
            "content": { "$ref": "#/$defs/dnsLabel" },
            "jobs": { "$ref": "#/$defs/dnsLabel" }
          }
        },
        "r2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactBucket", "deploymentStateBucket"],
          "properties": {
            "artifactBucket": { "$ref": "#/$defs/dnsLabel" },
            "deploymentStateBucket": { "$ref": "#/$defs/dnsLabel" }
          }
        },
        "queues": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobs", "deadLetter"],
          "properties": {
            "jobs": { "$ref": "#/$defs/dnsLabel" },
            "deadLetter": { "$ref": "#/$defs/dnsLabel" }
          }
        }
      }
    }
  }
}
