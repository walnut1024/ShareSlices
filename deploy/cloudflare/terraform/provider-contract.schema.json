{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shareslices.example/deploy/cloudflare/terraform/provider-contract.schema.json",
  "title": "ShareSlices Cloudflare Terraform provider contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerAddress",
    "providerVersion",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "providerAddress": {
      "const": "registry.terraform.io/cloudflare/cloudflare"
    },
    "providerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
        }
      }
    }
  }
}
